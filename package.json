{
  "name": "tangent-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Track learning sessions as a branching graph so tangents stay on purpose.",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "tg": "tsx src/cli/main.ts",
    "dev": "tsx src/server/main.ts",
    "app": "electron .",
    "shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/install-shortcuts.ps1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
